@@ -199,13 +276,25 @@ static void wifi_csi_rx_cb(void *ctx, wifi_csi_info_t *info)
         csi = ((int16_t)(((((uint16_t)info->buf[i + 1]) << 8) | info->buf[i]) << 4) >> 4);
