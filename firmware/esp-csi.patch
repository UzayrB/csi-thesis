     } else {
         ESP_ERROR_CHECK(esp_wifi_set_channel(CONFIG_LESS_INTERFERENCE_CHANNEL, WIFI_SECOND_CHAN_BELOW));
@@ -159,12 +160,34 @@ void app_main()
     ESP_LOGI(TAG, "wifi_channel: %d, send_frequency: %d, mac: " MACSTR,
              CONFIG_LESS_INTERFERENCE_CHANNEL, CONFIG_SEND_FREQUENCY, MAC2STR(CONFIG_CSI_SEND_MAC));
 
+    /* PROJECT MODIFICATION: schedule against a fixed deadline rather than
+     * sleeping a whole period after each send.
+     *
+     * Upstream slept 1000000/CONFIG_SEND_FREQUENCY microseconds AFTER
+     * esp_now_send returned, so the send call's own duration was added to
+     * every period and the achieved rate always fell short of the configured
+     * one. Measured here: 150 configured produced 125 Hz, and 80 produced
+     * 76.8 Hz. Tracking an absolute deadline makes the constant mean what it
+     * says, which matters because the achieved rate is the sampling rate of
+     * the whole experiment and ends up in the write-up. */
+    const int64_t period_us = 1000 * 1000 / CONFIG_SEND_FREQUENCY;
+    int64_t next_us = esp_timer_get_time();
+
     for (uint32_t count = 0; ; ++count) {
         esp_err_t ret = esp_now_send(peer.peer_addr, (const uint8_t *)&count, sizeof(count));
         if (ret != ESP_OK) {
             ESP_LOGW(TAG, "free_heap: %ld <%s> ESP-NOW send error", esp_get_free_heap_size(), esp_err_to_name(ret));
         }
 
-        usleep(1000 * 1000 / CONFIG_SEND_FREQUENCY);
+        next_us += period_us;
+        int64_t now_us = esp_timer_get_time();
+
+        if (next_us > now_us) {
+            usleep(next_us - now_us);
+        } else {
+            /* Fell behind: resynchronise instead of trying to catch up, which
+             * would burst packets and distort the very rate being measured. */
+            next_us = now_us;
+        }
     }
 }
