+/* ---------------------------------------------------------------------------
+ * Base64 CSI payload. PROJECT MODIFICATION, not upstream esp-csi.
+ *
+ * Upstream prints all 256 CSI values as decimal text, costing about 900 bytes
+ * per row. At 921600 baud that caps the console near 102 rows per second, and
+ * because ets_printf blocks until the FIFO drains, the packet rate ends up
+ * limited by printing rather than by the radio.
+ *
+ * Base64 of the raw payload is a fixed 344 characters, so a row costs about
+ * 440 bytes and the ceiling rises to roughly 209 rows per second. The fixed
+ * width also means bandwidth no longer varies with the values themselves.
+ *
+ * The raw int8 buffer is emitted UNSCALED, with the gain compensation factor
+ * sent alongside as an integer scaled by 10000. Scaling on the device would
+ * widen every value to int16 and double the payload, and keeping the factor
+ * explicit lets the host see what the AGC is actually doing.
+ * ------------------------------------------------------------------------ */
+static const char CSI_B64_ALPHABET[] =
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static void csi_b64_encode(const int8_t *in, int len, char *out, int out_size)
+{
+    int o = 0;
+
+    for (int i = 0; i < len; i += 3) {
+        uint32_t v = ((uint32_t)(uint8_t)in[i]) << 16;
+
+        if (i + 1 < len) {
+            v |= ((uint32_t)(uint8_t)in[i + 1]) << 8;
+        }
+        if (i + 2 < len) {
+            v |= (uint32_t)(uint8_t)in[i + 2];
+        }
+        if (o + 4 >= out_size) {
+            break;
+        }
+
+        out[o++] = CSI_B64_ALPHABET[(v >> 18) & 0x3F];
+        out[o++] = CSI_B64_ALPHABET[(v >> 12) & 0x3F];
+        out[o++] = (i + 1 < len) ? CSI_B64_ALPHABET[(v >> 6) & 0x3F] : '=';
+        out[o++] = (i + 2 < len) ? CSI_B64_ALPHABET[v & 0x3F] : '=';
+    }
+
+    out[o] = '\0';
+}
+
